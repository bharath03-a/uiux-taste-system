{
  "name": "uiux-taste-system",
  "version": "0.2.0",
  "description": "Framework-agnostic UI/UX Taste Lab (220+ prototypes, 10 font pairings, 6 style archetypes), Local Design MCP Server, WCAG/APCA Contrast Engine, Multi-Framework Token Generator, and Portable AI Agent Skills",
  "license": "MIT",
  "type": "module",
  "bin": {
    "taste-lint": "./packages/taste-linter/bin/taste-lint.mjs",
    "taste-tokens": "./packages/taste-linter/bin/taste-tokens.mjs",
    "taste-mcp": "./packages/taste-mcp/server.mjs"
  },
  "scripts": {
    "lab": "npm --prefix apps/taste-lab run dev",
    "build": "npm --prefix apps/taste-lab run build",
    "typecheck": "npm --prefix apps/taste-lab run typecheck",
    "lint:taste": "node packages/taste-linter/bin/taste-lint.mjs",
    "tokens:generate": "node packages/taste-linter/bin/taste-tokens.mjs",
    "mcp:taste": "node packages/taste-mcp/server.mjs",
    "install:skills": "node scripts/install-skills.mjs"
  },
  "keywords": [
    "ui",
    "ux",
    "design-system",
    "taste",
    "wcag",
    "apca",
    "contrast",
    "design-tokens",
    "agent-skills",
    "mcp",
    "multi-framework"
  ]
}
