{
  "name": "uiux-taste-system",
  "version": "0.3.0",
  "description": "Bun-powered, framework-agnostic UI/UX Taste Lab (30 categories / 270+ prototypes incl. Risk Adjustment Coding & Kinetic Motion, 10 font pairings, 6 style archetypes), Local Design MCP Server, WCAG/APCA Contrast Engine, Multi-Framework Token Generator, and 5 Portable AI Agent Skills",
  "license": "MIT",
  "type": "module",
  "bin": {
    "taste-lint": "./packages/taste-linter/bin/taste-lint.mjs",
    "taste-tokens": "./packages/taste-linter/bin/taste-tokens.mjs",
    "taste-mcp": "./packages/taste-mcp/server.mjs"
  },
  "scripts": {
    "lab": "bun run --cwd apps/taste-lab dev",
    "build": "bun run --cwd apps/taste-lab build",
    "typecheck": "bun run --cwd apps/taste-lab typecheck",
    "lint:taste": "bun packages/taste-linter/bin/taste-lint.mjs",
    "tokens:generate": "bun packages/taste-linter/bin/taste-tokens.mjs",
    "mcp:taste": "bun packages/taste-mcp/server.mjs",
    "install:skills": "bun scripts/install-skills.mjs"
  },
  "keywords": [
    "ui",
    "ux",
    "design-system",
    "taste",
    "bun",
    "wcag",
    "apca",
    "contrast",
    "design-tokens",
    "agent-skills",
    "mcp",
    "multi-framework",
    "risk-adjustment",
    "healthcare-ui"
  ]
}
